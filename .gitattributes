# Store text with LF line endings whatever the operating system,
# so Windows and Linux/macOS machines do not produce whole-file diffs.
* text=auto eol=lf

# Windows scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# The wireframe export is one huge generated file: keep it out of diffs and language statistics.
docs/wireframe/wireflow.html -diff linguist-generated
docs/wireframe/source/*.html linguist-documentation
